<% layout("/layouts/boilerplate") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10 col-12">
      <!-- Breadcrumb / Back Link -->
      <div class="mb-4 d-print-none">
        <a href="/bookings" class="text-muted text-decoration-none small d-inline-flex align-items-center gap-1 mb-2">
          <i class="fa-solid fa-arrow-left"></i> Back to My Bookings
        </a>
      </div>

      <!-- Receipt / Confirmation Card -->
      <div class="card p-4 p-md-5 rounded-4 border shadow-sm bg-white mb-4">
        <!-- Top Status & Reservation ID -->
        <div class="d-flex flex-wrap justify-content-between align-items-center pb-4 border-bottom gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <% if(booking.status === 'confirmed') { %>
                <span class="badge bg-success rounded-pill px-3 py-2">
                  <i class="fa-solid fa-circle-check me-1"></i> Reservation Confirmed
                </span>
              <% } else if(booking.status === 'cancelled') { %>
                <span class="badge bg-danger rounded-pill px-3 py-2">
                  <i class="fa-solid fa-circle-xmark me-1"></i> Cancelled & Refunded
                </span>
              <% } else { %>
                <span class="badge bg-secondary rounded-pill px-3 py-2">
                  Completed
                </span>
              <% } %>
            </div>
            <h3 class="fw-bold text-dark mb-0">Booking Confirmation</h3>
          </div>

          <div class="text-md-end text-start">
            <span class="text-muted small d-block">Reservation Code:</span>
            <strong class="fs-5 text-dark font-monospace">WL-<%= booking._id.toString().toUpperCase().slice(-8) %></strong>
          </div>
        </div>

        <!-- Property Summary -->
        <div class="py-4 border-bottom">
          <div class="row align-items-center g-3">
            <div class="col-md-4 col-12">
              <img 
                src="<%= booking.listing ? booking.listing.displayImage : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80' %>" 
                class="img-fluid rounded-3 w-100 object-fit-cover shadow-xs" 
                alt="Property" 
                style="height: 150px;"
              >
            </div>
            <div class="col-md-8 col-12">
              <h5 class="fw-bold mb-1 text-dark">
                <a href="/listings/<%= booking.listing ? booking.listing._id : '' %>" class="text-dark text-decoration-none">
                  <%= booking.listing ? booking.listing.title : "Property Listing" %>
                </a>
              </h5>
              <p class="text-muted small mb-2">
                <i class="fa-solid fa-location-dot me-1"></i>
                <%= booking.listing ? (booking.listing.location + ', ' + booking.listing.country) : "Destination" %>
              </p>
              <div class="small text-muted">
                Host: <strong class="text-dark"><%= (booking.listing && booking.listing.owner) ? (booking.listing.owner.name || booking.listing.owner.username) : "Wanderlust Host" %></strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Stay Details -->
        <div class="py-4 border-bottom">
          <h6 class="fw-bold text-dark mb-3">Stay Information</h6>
          <div class="row g-3">
            <div class="col-sm-6 col-12">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block text-uppercase fw-semibold mb-1">Check-in</span>
                <strong class="fs-6 text-dark d-block">
                  <%= new Date(booking.checkIn).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
                </strong>
                <span class="text-muted small">From 2:00 PM</span>
              </div>
            </div>

            <div class="col-sm-6 col-12">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block text-uppercase fw-semibold mb-1">Checkout</span>
                <strong class="fs-6 text-dark d-block">
                  <%= new Date(booking.checkOut).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
                </strong>
                <span class="text-muted small">Until 11:00 AM</span>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-between mt-3 text-secondary small">
            <span>Guests: <strong class="text-dark"><%= booking.guests %> <%= booking.guests === 1 ? 'guest' : 'guests' %></strong></span>
            <span>Duration: <strong class="text-dark"><%= booking.nights %> <%= booking.nights === 1 ? 'night' : 'nights' %></strong></span>
          </div>

          <% if(booking.specialRequests) { %>
            <div class="mt-3 p-3 bg-light-subtle border rounded-3 small">
              <strong class="text-dark d-block mb-1">Special Requests:</strong>
              <span class="text-secondary"><%= booking.specialRequests %></span>
            </div>
          <% } %>
        </div>

        <!-- Cost Breakdown -->
        <div class="py-4 border-bottom">
          <h6 class="fw-bold text-dark mb-3">Price Breakdown</h6>
          
          <div class="d-flex justify-content-between text-secondary mb-2 small">
            <span>&#8377;<%= booking.pricePerNight.toLocaleString("en-IN") %> x <%= booking.nights %> <%= booking.nights === 1 ? 'night' : 'nights' %></span>
            <span>&#8377;<%= (booking.pricePerNight * booking.nights).toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between text-secondary mb-2 small">
            <span>Cleaning fee</span>
            <span>&#8377;<%= booking.cleaningFee.toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between text-secondary mb-2 small">
            <span>Wanderlust service fee (8%)</span>
            <span>&#8377;<%= booking.serviceFee.toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between text-secondary mb-3 small">
            <span>Estimated taxes & GST</span>
            <span>&#8377;<%= booking.taxes.toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between pt-2 border-top fw-bold fs-5 text-dark">
            <span>Total Paid (INR)</span>
            <span>&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></span>
          </div>

          <div class="mt-3 p-2 bg-light rounded-3 d-flex align-items-center justify-content-between small text-muted">
            <span><i class="fa-solid fa-credit-card me-1 text-success"></i> Payment Method:</span>
            <span class="fw-semibold text-dark"><%= booking.paymentMethod %></span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="pt-4 d-flex flex-wrap justify-content-between align-items-center gap-2 d-print-none">
          <button class="btn btn-outline-secondary rounded-pill px-4" onclick="window.print()">
            <i class="fa-solid fa-print me-2"></i>Print Receipt
          </button>

          <% if(booking.status === 'confirmed') { %>
            <form method="POST" action="/bookings/<%= booking._id %>/cancel" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
              <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                <i class="fa-regular fa-calendar-xmark me-2"></i>Cancel Reservation
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

