<% layout("/layouts/boilerplate") %>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold text-dark mb-1">My Hosted Listings</h2>
      <p class="text-muted mb-0">Manage all your properties, pricing, and availability.</p>
    </div>
    <a href="/listings/new" class="btn btn-danger rounded-pill px-4 fw-bold" style="background-color: #ff385c; border-color: #ff385c;">
      <i class="fa-solid fa-plus me-2"></i>Add New Listing
    </a>
  </div>

  <% if(listings && listings.length > 0) { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
      <% for(let listing of listings) { %>
        <div class="col">
          <div class="card h-100 property-card border rounded-4 overflow-hidden shadow-xs">
            <div class="position-relative">
              <img 
                src="<%= listing.displayImage %>" 
                class="card-img-top" 
                alt="<%= listing.title %>" 
                style="height: 220px; object-fit: cover;"
                onerror="this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80'"
              >
              <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-2 rounded-pill px-3 py-1 text-capitalize">
                <%= listing.category ? listing.category.replace('-', ' ') : 'Stay' %>
              </span>
            </div>

            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <h6 class="fw-bold text-dark text-truncate mb-0" style="max-width: 80%;">
                  <%= listing.title %>
                </h6>
                <div class="small text-nowrap">
                  <i class="fa-solid fa-star text-warning"></i> 
                  <span class="fw-semibold"><%= listing.averageRating > 0 ? listing.averageRating : 'New' %></span>
                </div>
              </div>

              <p class="text-muted small mb-2 text-truncate">
                <i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>, <%= listing.country %>
              </p>

              <div class="fw-bold text-dark mb-3">
                &#8377;<%= listing.price.toLocaleString("en-IN") %> <span class="text-muted small fw-normal">/ night</span>
              </div>

              <!-- Host Action Buttons -->
              <div class="d-flex align-items-center gap-2 pt-2 border-top">
                <a href="/listings/<%= listing._id %>" class="btn btn-outline-dark btn-sm rounded-pill flex-grow-1">
                  View
                </a>
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-secondary btn-sm rounded-pill flex-grow-1">
                  Edit
                </a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete listing permanently?');" class="d-inline">
                  <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Delete">
                    <i class="fa-regular fa-trash-can"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="text-center py-5 my-4 border rounded-4 bg-light-subtle">
      <div class="mb-3 text-secondary">
        <i class="fa-solid fa-house-chimney-medical display-3"></i>
      </div>
      <h4 class="fw-bold text-dark mb-2">You haven't listed any properties yet</h4>
      <p class="text-muted mb-4 max-w-md mx-auto">
        Join thousands of hosts earning extra income by sharing their space on Wanderlust.
      </p>
      <a href="/listings/new" class="btn btn-danger rounded-pill px-4 fw-bold" style="background-color: #ff385c; border-color: #ff385c;">
        Create your first listing
      </a>
    </div>
  <% } %>
</div>

