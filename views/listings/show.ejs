<% layout("/layouts/boilerplate") %>

<div class="listing-show-container py-3">
  <!-- Top Header: Title & Actions -->
  <div class="listing-header mb-3">
    <h2 class="fw-bold mb-2 text-dark"><%= listing.title %></h2>
    <div class="d-flex flex-wrap justify-content-between align-items-center text-muted small gap-2">
      <div class="d-flex align-items-center gap-2">
        <span class="d-flex align-items-center gap-1 text-dark fw-semibold">
          <i class="fa-solid fa-star text-warning"></i> 
          <%= listing.averageRating > 0 ? listing.averageRating : 'New' %>
        </span>
        <span>&middot;</span>
        <a href="#reviews" class="text-dark fw-semibold text-decoration-underline">
          <%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %>
        </a>
        <span>&middot;</span>
        <span class="text-capitalize badge bg-light text-dark border">
          <%= listing.category ? listing.category.replace('-', ' ') : 'Stay' %>
        </span>
        <span>&middot;</span>
        <span class="text-decoration-underline text-dark fw-medium">
          <%= listing.location %>, <%= listing.country %>
        </span>
      </div>

      <div class="d-flex align-items-center gap-3">
        <!-- Wishlist Toggle -->
        <% if(currUser) { %>
          <button 
            type="button" 
            class="btn btn-outline-secondary btn-sm rounded-pill d-flex align-items-center gap-2 wishlist-btn-show <%= isWishlisted ? 'text-danger' : '' %>"
            data-listing-id="<%= listing._id %>"
          >
            <i class="<%= isWishlisted ? 'fa-solid text-danger' : 'fa-regular' %> fa-heart"></i>
            <span><%= isWishlisted ? 'Saved' : 'Save' %></span>
          </button>
        <% } %>

        <!-- Share Button (Copies Link) -->
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill d-flex align-items-center gap-2" onclick="navigator.clipboard.writeText(window.location.href); alert('Listing link copied to clipboard!');">
          <i class="fa-solid fa-arrow-up-from-bracket"></i>
          <span>Share</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Image Gallery -->
  <div class="listing-gallery mb-4 rounded-4 overflow-hidden shadow-sm">
    <div class="row g-2">
      <% if(listing.images && listing.images.length > 1) { %>
        <!-- Multi-Image Grid -->
        <div class="col-md-8 col-12">
          <img src="<%= listing.images[0].url %>" class="gallery-primary-img img-fluid w-100 object-fit-cover" alt="<%= listing.title %>" style="max-height: 440px; min-height: 320px;">
        </div>
        <div class="col-md-4 d-none d-md-flex flex-column gap-2">
          <% for(let i = 1; i < Math.min(listing.images.length, 3); i++) { %>
            <img src="<%= listing.images[i].url %>" class="gallery-sub-img img-fluid w-100 object-fit-cover rounded-3" alt="Property image <%= i %>" style="height: 215px;">
          <% } %>
        </div>
      <% } else { %>
        <!-- Single Primary Image -->
        <div class="col-12">
          <img 
            src="<%= listing.displayImage %>" 
            class="gallery-primary-img img-fluid w-100 object-fit-cover" 
            alt="<%= listing.title %>" 
            style="max-height: 480px; min-height: 340px; border-radius: 1.25rem;"
            onerror="this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80'"
          >
        </div>
      <% } %>
    </div>
  </div>

  <!-- Main Details Content & Booking Card -->
  <div class="row g-5">
    <!-- Left Column: Details, Amenities, Map, Reviews -->
    <div class="col-lg-7 col-md-12">
      <!-- Host Header -->
      <div class="d-flex justify-content-between align-items-center pb-4 border-bottom">
        <div>
          <h4 class="fw-bold mb-1 text-dark">
            Entire home hosted by <%= listing.owner ? (listing.owner.name || listing.owner.username) : "Wanderlust Host" %>
          </h4>
          <p class="text-muted small mb-0">
            Dedicated host &middot; Seamless self check-in &middot; Curated hospitality
          </p>
        </div>
        <div>
          <% if(listing.owner && listing.owner.avatar && listing.owner.avatar.url) { %>
            <img src="<%= listing.owner.avatar.url %>" alt="Host avatar" class="rounded-circle shadow-sm" style="width: 56px; height: 56px; object-fit: cover;">
          <% } else { %>
            <div class="user-avatar-placeholder rounded-circle" style="width: 56px; height: 56px; font-size: 1.5rem;">
              <i class="fa-solid fa-user"></i>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Key Property Features -->
      <div class="py-4 border-bottom d-flex flex-column gap-3">
        <div class="d-flex align-items-start gap-3">
          <i class="fa-solid fa-door-open fs-4 text-muted mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Self check-in</h6>
            <span class="text-muted small">Check yourself in with the smart lock or keypad anytime after 2:00 PM.</span>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3">
          <i class="fa-solid fa-location-dot fs-4 text-muted mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Great location</h6>
            <span class="text-muted small">95% of recent guests gave the location a 5-star rating.</span>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3">
          <i class="fa-solid fa-calendar-xmark fs-4 text-muted mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Free cancellation for 48 hours</h6>
            <span class="text-muted small">Get a full refund if you change your plans up to 48 hours before check-in.</span>
          </div>
        </div>
      </div>

      <!-- WanderCover Protection Banner -->
      <div class="py-4 border-bottom">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="fw-black fs-4 text-danger font-monospace">wander</span><span class="fw-black fs-4 text-dark font-monospace">cover</span>
        </div>
        <p class="text-muted small mb-0">
          Every booking includes free protection from Host cancellations, listing inaccuracies, and other issues like trouble checking in.
        </p>
      </div>

      <!-- Description -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3">About this space</h5>
        <div class="listing-description text-secondary lh-lg" style="white-space: pre-line;">
          <%= listing.description %>
        </div>
      </div>

      <!-- Amenities Section -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3">What this place offers</h5>
        <div class="row row-cols-md-2 row-cols-1 g-3">
          <% const amenityIcons = {
            "Wifi": "fa-solid fa-wifi",
            "Air conditioning": "fa-solid fa-snowflake",
            "Kitchen": "fa-solid fa-utensils",
            "Free parking": "fa-solid fa-square-parking",
            "Dedicated workspace": "fa-solid fa-laptop",
            "Pool": "fa-solid fa-person-swimming",
            "TV": "fa-solid fa-tv",
            "Pet friendly": "fa-solid fa-paw",
            "Washing machine": "fa-solid fa-soap",
            "Balcony": "fa-solid fa-sun",
            "BBQ grill": "fa-solid fa-fire-burner",
            "Smoke alarm": "fa-solid fa-bell"
          }; %>

          <% if(listing.amenities && listing.amenities.length > 0) { %>
            <% for(let amenity of listing.amenities) { %>
              <div class="col d-flex align-items-center gap-3">
                <i class="<%= amenityIcons[amenity] || 'fa-solid fa-circle-check' %> fs-5 text-muted" style="width: 24px;"></i>
                <span class="text-secondary"><%= amenity %></span>
              </div>
            <% } %>
          <% } else { %>
            <div class="col d-flex align-items-center gap-3">
              <i class="fa-solid fa-wifi fs-5 text-muted"></i>
              <span class="text-secondary">High-speed Wifi</span>
            </div>
            <div class="col d-flex align-items-center gap-3">
              <i class="fa-solid fa-utensils fs-5 text-muted"></i>
              <span class="text-secondary">Fully equipped Kitchen</span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Interactive Map Section -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-2">Where you'll be</h5>
        <p class="text-muted small mb-3">
          <i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>, <%= listing.country %>
        </p>
        <div id="map" class="rounded-4 border shadow-sm" style="height: 350px; width: 100%;"></div>
      </div>

      <!-- Owner Actions (if owner of listing) -->
      <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="py-4 border-bottom d-flex align-items-center gap-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4">
            <i class="fa-regular fa-pen-to-square me-2"></i>Edit Listing
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to permanently delete this listing?');">
            <button class="btn btn-outline-danger rounded-pill px-4">
              <i class="fa-regular fa-trash-can me-2"></i>Delete Listing
            </button>
          </form>
        </div>
      <% } %>

      <!-- Reviews & Ratings Section -->
      <div class="py-4" id="reviews">
        <div class="d-flex align-items-center gap-2 mb-4">
          <i class="fa-solid fa-star text-warning fs-4"></i>
          <h4 class="fw-bold mb-0">
            <%= listing.averageRating > 0 ? listing.averageRating : 'No reviews yet' %>
          </h4>
          <span class="text-muted fs-5">&middot;</span>
          <span class="fs-5 text-muted">
            <%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %>
          </span>
        </div>

        <!-- Add Review Form (for logged-in users who aren't the host) -->
        <% if(currUser) { %>
          <div class="card p-4 rounded-4 border bg-light-subtle mb-4">
            <h5 class="fw-bold mb-2">Leave a Review</h5>
            <p class="text-muted small mb-3">Share your stay experience with the Wanderlust community.</p>

            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
              <!-- Interactive Star Rating Input -->
              <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Rating</label>
                <div class="star-rating-input d-flex align-items-center gap-2">
                  <div class="rating-stars d-flex flex-row-reverse justify-content-end">
                    <input type="radio" id="star5" name="review[rating]" value="5" required>
                    <label for="star5" title="5 stars"><i class="fa-solid fa-star"></i></label>
                    <input type="radio" id="star4" name="review[rating]" value="4">
                    <label for="star4" title="4 stars"><i class="fa-solid fa-star"></i></label>
                    <input type="radio" id="star3" name="review[rating]" value="3">
                    <label for="star3" title="3 stars"><i class="fa-solid fa-star"></i></label>
                    <input type="radio" id="star2" name="review[rating]" value="2">
                    <label for="star2" title="2 stars"><i class="fa-solid fa-star"></i></label>
                    <input type="radio" id="star1" name="review[rating]" value="1">
                    <label for="star1" title="1 star"><i class="fa-solid fa-star"></i></label>
                  </div>
                </div>
                <div class="invalid-feedback">Please select a star rating.</div>
              </div>

              <!-- Comment Input -->
              <div class="mb-3">
                <label for="reviewComment" class="form-label fw-semibold small text-muted">Your Experience</label>
                <textarea 
                  name="review[comment]" 
                  id="reviewComment" 
                  rows="3" 
                  class="form-control rounded-3" 
                  placeholder="How was your stay? Was the location convenient? How was the host?" 
                  required 
                  minlength="3"
                ></textarea>
                <div class="invalid-feedback">Please enter a review comment (minimum 3 characters).</div>
              </div>

              <button type="submit" class="btn btn-dark rounded-pill px-4">Submit Review</button>
            </form>
          </div>
        <% } else { %>
          <div class="alert alert-light border rounded-3 p-3 mb-4 d-flex align-items-center justify-content-between">
            <span class="text-muted small">Have you stayed here? Log in to leave a review and rating.</span>
            <a href="/login" class="btn btn-sm btn-outline-dark rounded-pill">Log in</a>
          </div>
        <% } %>

        <!-- Existing Reviews Grid -->
        <% if(listing.reviews && listing.reviews.length > 0) { %>
          <div class="row row-cols-md-2 row-cols-1 g-4">
            <% for(let review of listing.reviews) { %>
              <div class="col">
                <div class="card h-100 p-3 rounded-4 border bg-white shadow-xs">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <% if(review.author && review.author.avatar && review.author.avatar.url) { %>
                        <img src="<%= review.author.avatar.url %>" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="<%= review.author.username %>">
                      <% } else { %>
                        <div class="user-avatar-placeholder rounded-circle" style="width: 40px; height: 40px; font-size: 1rem;">
                          <i class="fa-solid fa-user"></i>
                        </div>
                      <% } %>
                      <div>
                        <h6 class="fw-bold mb-0 text-dark">
                          <%= review.author ? (review.author.name || review.author.username) : "Traveler" %>
                        </h6>
                        <span class="text-muted" style="font-size: 0.75rem;">
                          <%= new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
                        </span>
                      </div>
                    </div>

                    <!-- Stars -->
                    <div class="small text-warning">
                      <% for(let s = 1; s <= 5; s++) { %>
                        <i class="<%= s <= review.rating ? 'fa-solid' : 'fa-regular text-secondary' %> fa-star"></i>
                      <% } %>
                    </div>
                  </div>

                  <p class="text-secondary small mb-2 lh-base">
                    <%= review.comment %>
                  </p>

                  <!-- Delete Review Button for Author -->
                  <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-auto pt-2" onsubmit="return confirm('Delete this review?');">
                      <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none small">
                        <i class="fa-regular fa-trash-can me-1"></i>Delete
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted small">No reviews yet for this listing. Be the first to share your thoughts!</p>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Sticky Booking Widget -->
    <div class="col-lg-5 col-md-12">
      <div class="sticky-top" style="top: 6rem; z-index: 10;">
        <div class="card booking-widget-card p-4 rounded-4 border shadow-sm">
          <!-- Widget Header: Price & Rating -->
          <div class="d-flex justify-content-between align-items-baseline mb-4">
            <div>
              <span class="fs-3 fw-bold text-dark">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
              <span class="text-muted"> / night</span>
            </div>
            <div class="d-flex align-items-center gap-1 small">
              <i class="fa-solid fa-star text-warning"></i>
              <span class="fw-bold"><%= listing.averageRating > 0 ? listing.averageRating : 'New' %></span>
              <span class="text-muted">&middot;</span>
              <a href="#reviews" class="text-muted text-decoration-underline"><%= listing.reviews.length %> reviews</a>
            </div>
          </div>

          <!-- Booking Form -->
          <form action="/listings/<%= listing._id %>/bookings" method="POST" id="bookingForm" novalidate class="needs-validation">
            <!-- Date Picker Box -->
            <div class="booking-dates-box border rounded-3 overflow-hidden mb-3">
              <div class="row g-0">
                <div class="col-6 border-end p-2">
                  <label for="checkInDate" class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem;">Check-in</label>
                  <input 
                    type="date" 
                    id="checkInDate" 
                    name="booking[checkIn]" 
                    class="form-control form-control-sm border-0 p-0 fw-semibold" 
                    required
                  >
                </div>
                <div class="col-6 p-2">
                  <label for="checkOutDate" class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem;">Checkout</label>
                  <input 
                    type="date" 
                    id="checkOutDate" 
                    name="booking[checkOut]" 
                    class="form-control form-control-sm border-0 p-0 fw-semibold" 
                    required
                  >
                </div>
              </div>
              <div class="p-2 border-top">
                <label for="bookingGuests" class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem;">Guests</label>
                <select id="bookingGuests" name="booking[guests]" class="form-select form-select-sm border-0 p-0 fw-semibold">
                  <option value="1">1 guest</option>
                  <option value="2">2 guests</option>
                  <option value="3">3 guests</option>
                  <option value="4">4 guests</option>
                  <option value="5">5 guests</option>
                  <option value="6">6+ guests</option>
                </select>
              </div>
            </div>

            <!-- Special Requests (Optional) -->
            <div class="mb-3">
              <label for="specialRequests" class="form-label text-muted small mb-1">Special requests (optional)</label>
              <textarea 
                name="booking[specialRequests]" 
                id="specialRequests" 
                rows="2" 
                class="form-control form-control-sm rounded-3" 
                placeholder="Early check-in, quiet room, etc."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <% if(currUser) { %>
              <button type="submit" class="btn btn-reserve w-100 py-3 rounded-3 fw-bold fs-6 mb-2">
                Reserve
              </button>
            <% } else { %>
              <a href="/login" class="btn btn-reserve w-100 py-3 rounded-3 fw-bold fs-6 mb-2 text-center text-decoration-none">
                Log in to Reserve
              </a>
            <% } %>

            <p class="text-center text-muted small mb-3">You won't be charged yet</p>

            <!-- Dynamic Price Breakdown -->
            <div id="priceBreakdown" class="d-none border-top pt-3">
              <div class="d-flex justify-content-between text-secondary mb-2 small">
                <span id="rateCalculation">&#8377;<%= listing.price %> x 1 night</span>
                <span id="subtotalPrice">&#8377;<%= listing.price %></span>
              </div>
              <div class="d-flex justify-content-between text-secondary mb-2 small">
                <span>Cleaning fee</span>
                <span>&#8377;500</span>
              </div>
              <div class="d-flex justify-content-between text-secondary mb-2 small">
                <span>Wanderlust service fee (8%)</span>
                <span id="serviceFee">&#8377;0</span>
              </div>
              <div class="d-flex justify-content-between text-secondary mb-3 small">
                <span>Estimated taxes (12%)</span>
                <span id="taxFee">&#8377;0</span>
              </div>
              <hr>
              <div class="d-flex justify-content-between fw-bold fs-6 text-dark">
                <span>Total before taxes / Total</span>
                <span id="finalTotalPrice">&#8377;0</span>
              </div>
            </div>

            <!-- Demo Payment Mode Banner -->
            <div class="mt-3 p-2 bg-light border rounded-3 text-center small text-muted">
              <i class="fa-solid fa-shield-halved text-success me-1"></i>
              <strong class="text-dark">Demo Mode:</strong> Instant reservation with free cancellation.
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Map & Booking Scripts -->
<script>
  const listingCoords = <%= JSON.stringify(listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : [77.2090, 28.6139]) %>;
  const listingTitle = "<%= listing.title.replace(/"/g, '&quot;') %>";
  const listingLocation = "<%= listing.location.replace(/"/g, '&quot;') %>, <%= listing.country.replace(/"/g, '&quot;') %>";
  const pricePerNight = <%= listing.price %>;
  const bookedDates = <%= bookedDates || '[]' %>;

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Initialize Leaflet Map
    if (document.getElementById("map")) {
      const lon = listingCoords[0];
      const lat = listingCoords[1];

      const map = L.map('map').setView([lat, lon], 12);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);

      // Custom marker icon
      const customIcon = L.divIcon({
        className: 'custom-map-marker',
        html: '<div class="marker-pin"><i class="fa-solid fa-house-chimney"></i></div>',
        iconSize: [36, 36],
        iconAnchor: [18, 36]
      });

      L.marker([lat, lon], { icon: customIcon })
        .addTo(map)
        .bindPopup(`<b>${listingTitle}</b><br>${listingLocation}`)
        .openPopup();
    }

    // 2. Initialize Date Picker Restrictions & Live Cost Calculation
    const checkInInput = document.getElementById("checkInDate");
    const checkOutInput = document.getElementById("checkOutDate");
    const priceBreakdown = document.getElementById("priceBreakdown");
    const rateCalculation = document.getElementById("rateCalculation");
    const subtotalPriceEl = document.getElementById("subtotalPrice");
    const serviceFeeEl = document.getElementById("serviceFee");
    const taxFeeEl = document.getElementById("taxFee");
    const finalTotalPriceEl = document.getElementById("finalTotalPrice");

    // Set minimum check-in date to today
    const today = new Date().toISOString().split("T")[0];
    checkInInput.min = today;

    // Set tomorrow for default checkout min
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    checkOutInput.min = tomorrow.toISOString().split("T")[0];

    function updatePrice() {
      const inVal = checkInInput.value;
      const outVal = checkOutInput.value;

      if (!inVal || !outVal) {
        priceBreakdown.classList.add("d-none");
        return;
      }

      const inDate = new Date(inVal);
      const outDate = new Date(outVal);

      if (outDate <= inDate) {
        priceBreakdown.classList.add("d-none");
        return;
      }

      const diffTime = Math.abs(outDate - inDate);
      const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      if (nights >= 1) {
        const subtotal = nights * pricePerNight;
        const cleaning = 500;
        const service = Math.round(subtotal * 0.08);
        const taxes = Math.round((subtotal + service) * 0.12);
        const total = subtotal + cleaning + service + taxes;

        rateCalculation.innerText = `₹${pricePerNight.toLocaleString("en-IN")} x ${nights} ${nights === 1 ? 'night' : 'nights'}`;
        subtotalPriceEl.innerText = `₹${subtotal.toLocaleString("en-IN")}`;
        serviceFeeEl.innerText = `₹${service.toLocaleString("en-IN")}`;
        taxFeeEl.innerText = `₹${taxes.toLocaleString("en-IN")}`;
        finalTotalPriceEl.innerText = `₹${total.toLocaleString("en-IN")}`;

        priceBreakdown.classList.remove("d-none");
      }
    }

    checkInInput.addEventListener("change", () => {
      if (checkInInput.value) {
        const nextDay = new Date(checkInInput.value);
        nextDay.setDate(nextDay.getDate() + 1);
        checkOutInput.min = nextDay.toISOString().split("T")[0];
        if (checkOutInput.value && new Date(checkOutInput.value) <= new Date(checkInInput.value)) {
          checkOutInput.value = nextDay.toISOString().split("T")[0];
        }
      }
      updatePrice();
    });

    checkOutInput.addEventListener("change", updatePrice);
  });
</script>
