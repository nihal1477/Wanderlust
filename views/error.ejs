<% layout("/layouts/boilerplate") %>

<div class="container py-5 my-4">
  <div class="row justify-content-center text-center">
    <div class="col-lg-6 col-md-8 col-12">
      <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm">
        <div class="mb-4 text-danger">
          <i class="fa-solid fa-triangle-exclamation display-2"></i>
        </div>
        <h1 class="display-5 fw-bold text-dark mb-2">
          <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
        </h1>
        <h4 class="fw-bold text-dark mb-3">
          <%= typeof message !== 'undefined' ? message : "Something went wrong!" %>
        </h4>
        <p class="text-muted mb-4">
          We encountered an issue processing your request. Please return to the homepage or explore available stays.
        </p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/listings" class="btn btn-dark rounded-pill px-4 py-2">
            Return to Explore
          </a>
          <button class="btn btn-outline-secondary rounded-pill px-4 py-2" onclick="history.back()">
            Go Back
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
