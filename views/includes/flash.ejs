<% if(success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show col-lg-8 offset-lg-2 col-md-10 offset-md-1 mt-3 custom-alert" role="alert">
    <div class="d-flex align-items-center">
      <i class="fa-solid fa-circle-check me-2 fs-5"></i>
      <div><%= success %></div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if(error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show col-lg-8 offset-lg-2 col-md-10 offset-md-1 mt-3 custom-alert" role="alert">
    <div class="d-flex align-items-center">
      <i class="fa-solid fa-circle-exclamation me-2 fs-5"></i>
      <div><%= error %></div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

