<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-12">
      <div class="card p-4 p-md-5 rounded-4 border shadow-sm bg-white">
        <h2 class="fw-bold text-dark mb-4">Terms of Service</h2>
        <p class="text-muted small">Effective date: November 2026</p>

        <section class="mb-4">
          <h5 class="fw-bold text-dark">1. Acceptance of Terms</h5>
          <p class="text-secondary lh-lg">
            By accessing or using Wanderlust, you agree to comply with and be bound by these Terms of Service. If you do not agree, please do not use our services.
          </p>
        </section>

        <section class="mb-4">
          <h5 class="fw-bold text-dark">2. Host Commitments</h5>
          <p class="text-secondary lh-lg">
            Hosts are responsible for the accuracy of their property descriptions, pricing, house rules, and amenities. Properties must be safe, clean, and available on the dates confirmed.
          </p>
        </section>

        <section class="mb-4">
          <h5 class="fw-bold text-dark">3. Guest Responsibilities</h5>
          <p class="text-secondary lh-lg">
            Guests agree to treat accommodation with respect, abide by host rules, and vacate the premises on the scheduled check-out date. Damage or unauthorized guests may result in penalties.
          </p>
        </section>

        <section class="mb-4">
          <h5 class="fw-bold text-dark">4. Cancellation & Refund Policy</h5>
          <p class="text-secondary lh-lg">
            Guests can cancel eligible reservations up to 48 hours prior to check-in for a full refund. Specific host terms may apply depending on listing settings.
          </p>
        </section>

        <div class="border-top pt-3">
          <a href="/listings" class="btn btn-dark rounded-pill px-4">Back to Explore</a>
        </div>
      </div>
    </div>
  </div>
</div>

