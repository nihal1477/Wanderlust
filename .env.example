# Server Configuration
PORT=8080
NODE_ENV=development

# Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/wanderlust
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/wanderlust?retryWrites=true&w=majority
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust

# Session Secret (Change to a random secure key in production)
SECRET=wanderlust_super_secret_session_key_12345

# Cloudinary Storage (Optional - falls back automatically to local /public/uploads/ if omitted)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

